# Copy this to .env and fill in your own values.
AZURE_AI_ENDPOINT=""
AZURE_OPENAI_ENDPOINT=""
AZURE_AI_API_KEY=""
AZURE_MODEL_DEPLOYMENT="gpt-4o-mini"
AZURE_AI_AGENT_NAME="AI-Study-Assistant"
AZURE_AI_AGENT_VERSION="2"

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional SMTP for login notifications (Gmail example)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
SMTP_FROM="your-gmail@gmail.com"
SMTP_STARTTLS="true"
SMTP_LOGIN_NOTIFICATION_ENABLED="false"
